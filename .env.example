# Copy to .env (or set as fly.io secrets) and fill in.

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100

# --- Slack (optional) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C01234567

# --- Email via SMTP ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=cupid@yourdomain.com

# --- Runtime ---
CONFIG_PATH=/data/config.yaml
STATE_PATH=/data/state.json
LOG_LEVEL=INFO

# --- Booking secrets (kept out of config.yaml so they aren't accidentally committed) ---
# The Salesforce site usually does not require login for booking, but if it does:
CUPID_LOGIN_EMAIL=
CUPID_LOGIN_PASSWORD=

# Optional: 2Captcha API key. Only set if you want CAPTCHA solving for full auto-book.
# Without this, hitting a CAPTCHA falls back to "drive to confirmation, SMS you to submit".
TWOCAPTCHA_API_KEY=
